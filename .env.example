# Folder containing source PDF documents.
DATA_DIR=./data
# Folder used to store and reuse the FAISS index.
INDEX_DIR=./faiss_index
# Hugging Face sentence-transformer model used for embeddings.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Maximum number of characters in each text chunk.
CHUNK_SIZE=800
# Number of overlapping characters between neighboring chunks.
CHUNK_OVERLAP=100
# Number of relevant chunks retrieved for each question.
TOP_K=4
# Local Ollama model used to generate answers.
OLLAMA_MODEL=llama3.2
# Base URL of the local Ollama server.
OLLAMA_BASE_URL=http://localhost:11434
# Ollama response randomness; zero is deterministic.
TEMPERATURE=0
